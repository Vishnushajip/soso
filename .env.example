APP_NAME=SOS Arena
SUPPORT_EMAIL=info.playsoso@gmail.com
# Web OAuth Client ID (also used as Android serverClientId for Firebase ID-token exchange)
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
PRESENCE_HEARTBEAT_SECONDS=45
BOARD_SIZE=8
ENABLE_CRASHLYTICS=true
ENABLE_ANALYTICS=true
# WARNING: .env is bundled into the app as an asset, so anything here is public.
# Do NOT put a real service-account key here; send FCM from a Cloud Function instead.
FCM_SERVICE_ACCOUNT_JSON=
