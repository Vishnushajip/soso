rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function existingFriendship(a, b) {
      return exists(/databases/$(database)/documents/friends/$(friendshipId(a, b)));
    }
    function friendshipId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // -------- USERS --------
    match /users/{uid} {
      allow read: if isSignedIn();
      // First-time create must match the calling user.
      allow create: if isSelf(uid) && request.resource.data.uid == uid;
      // Owners can update profile + their token / presence.
      allow update: if isSelf(uid);
      // Other signed-in users may bump only friendsCount (atomic increments handled server-side).
      allow delete: if false;
    }

    // -------- FRIEND REQUESTS --------
    match /friend_requests/{reqId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.fromUid != request.resource.data.toUid &&
        request.resource.data.status == 'pending';
      allow update: if isSignedIn() &&
        resource.data.toUid == request.auth.uid &&
        request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // -------- FRIENDS --------
    match /friends/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
      allow update: if false;
    }

    // -------- CHAT ROOMS --------
    match /chat_rooms/{roomId} {
      allow read: if isSignedIn() &&
        (resource.data.type == 'global' || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() &&
        (resource.data.type == 'global' || request.auth.uid in resource.data.participants);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.type == 'global'
           || request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants);
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          (get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.type in ['global', 'match']
           || request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants);
        allow update, delete: if false;
      }
    }

    // -------- GAME ROOMS --------
    match /game_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.hostId == request.auth.uid &&
        request.auth.uid in request.resource.data.playerIds;
      allow update: if isSignedIn() && request.auth.uid in resource.data.playerIds;
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      match /moves/{moveId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/game_rooms/$(roomId)).data.playerIds;
        allow create: if isSignedIn() &&
          request.resource.data.playerId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/game_rooms/$(roomId)).data.playerIds;
        allow update, delete: if false;
      }
    }

    // -------- NOTIFICATIONS --------
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.toUid == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.toUid == request.auth.uid;
    }

    // -------- LEADERBOARDS (read-only client view) --------
    match /leaderboards/{entryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // -------- ANALYTICS --------
    match /analytics/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
